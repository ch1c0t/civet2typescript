import { useEffect } from 'react'
import { useAtom } from 'jotai'

import inputAtom from '../atoms/input'

function Input(): React.JSX.Element
  const [input, setInput] = useAtom(inputAtom)
  
  const handleCtrlU = (event) =>
    if ((event.ctrlKey || event.metaKey) && event.key === 'u')
      event.preventDefault()
      setInput ''
    
  useEffect
    =>
      document.addEventListener 'keydown', handleCtrlU
      =>
        document.removeEventListener 'keydown', handleCtrlU
    []

  const handleChange = (e) =>
    setInput(e.target.value)

  <textarea #input autoFocus
    value={input}
    onChange={handleChange}
    className="bg-green-200 w-full h-[100%!important] text-black">

export default Input